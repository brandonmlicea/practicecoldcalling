# The prospect's brain. Any OpenAI-compatible /chat/completions endpoint.
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=
# Optional: extra JSON merged into every chat request, e.g. {"reasoning_effort":"none"}
CHAT_EXTRA=
CHAT_TIMEOUT_MS=30000

# Your voice to text, via /audio/transcriptions. Blank STT_MODEL: you type your lines.
# STT_BASE_URL and STT_API_KEY default to the CHAT ones.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# The prospect's voice, via /audio/speech. Blank TTS_MODEL: replies in text only.
# TTS_BASE_URL and TTS_API_KEY default to the CHAT ones.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICES_MALE=onyx,echo,ash
TTS_VOICES_FEMALE=nova,shimmer,coral

# Optional: ElevenLabs voices instead (used first when set).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

PORT=8787
# Set to 1 to skip opening the browser.
NO_OPEN=
